{
  "name": "sc4053-project",
  "version": "1.0.0",
  "scripts": {
    "dev"           : "next dev -p 5173",
    "build"         : "next build",
    "start"         : "next start -p 5173",
    "compile"       : "hardhat compile",
    "clean"         : "hardhat clean",
    "node"          : "hardhat node --hostname 127.0.0.1 --port 8545",
    "deploy:all"    : "node scripts/deployAll.js",
    "deploy:mock"   : "hardhat ignition deploy ./ignition/modules/Token.js --network localhost",
    "deploy:dex"    : "hardhat ignition deploy ./ignition/modules/Dex.js --network localhost",

    "deploy:copy"   : "hardhat run --network localhost scripts/copyDeployments.js",
    "mint"          : "hardhat run --network localhost scripts/mintTokensToAccount.js",
    "seedOrder"     : "hardhat run --network localhost scripts/seedOrderBook.js",
    "balance"       : "hardhat run --network localhost scripts/checkBalances.js",
    "batchexecute"  : "hardhat run --network localhost scripts/testBatchExecution.js",
    "get:addresses" : "hardhat run --network localhost scripts/addresses.js",

    "test"          : "hardhat test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "dotenv": "^17.2.3",
    "hardhat": "^2.26.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "bignumber.js": "^9.3.1",
    "node": "^22.17.1",
    "typescript": "^5.8.3",
    "viem": "^2.33.0",
    "vite": "^7.0.5"
  }
}
